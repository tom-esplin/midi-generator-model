# Local development defaults to the Vite proxy when this is blank.
# For GitHub Pages, set this to the origin of your hosted model API.
# Example for a Hugging Face Space: https://your-username-your-space.hf.space
VITE_API_URL=

# GitHub Pages project sites usually need /repo-name/.
# User or organization sites such as https://username.github.io/ should use /.
VITE_BASE_PATH=/
